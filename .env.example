# ==============================================================================
# NARASA AI - ENVIRONMENT VARIABLES CONFIGURATION (VERCEL & PRODUCTION READY)
# ==============================================================================

# 1. GOOGLE GEMINI AI API KEY (Wajib untuk analisis foto & scaffolding penalaran)
# Dapat disalin langsung ke Settings > Environment Variables di dashboard Vercel.
# Sistem secara otomatis mendukung nama variabel: GEMINI_API_KEY, GOOGLE_GENAI_API_KEY, atau GOOGLE_API_KEY
GEMINI_API_KEY=

# 2. SUPABASE DATABASE & AUTH (Opsional - untuk sinkronisasi database cloud)
# Dapat dinamakan VITE_SUPABASE_URL atau SUPABASE_URL
VITE_SUPABASE_URL=

# Public Anonymous API Key Supabase (anon key)
# Dapat dinamakan VITE_SUPABASE_ANON_KEY atau SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=

# 3. APP CONFIGURATION
# Otomatis diisi oleh Vercel / Cloud Run runtime
APP_URL=

